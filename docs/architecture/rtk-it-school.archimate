<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="CRM ИТ Школы Ростелекома" id="id-1d06a0d76f000e6edd18de49" version="5.0.0">
  <folder name="Strategy" id="id-7e132fd94442af627b5df127" type="strategy"/>
  <folder name="Business" id="id-89ce7930feed9a1f317287b5" type="business">
    <element xsi:type="archimate:BusinessActor" name="Менеджер по вузам (КАМ)" id="id-1a8565a9dc72048ba03b4156">
      <documentation>Ведёт свои взаимодействия с вузами.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Руководитель" id="id-8cb33b2754e53feca4f75fca">
      <documentation>Команда менеджеров: ответственные, этапы, импорт, интеграции.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Администратор платформы" id="id-d033e22ae348aeb5660fc214">
      <documentation>Права, видимость данных, настройки.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Ведение взаимодействия с вузом (14 этапов)" id="id-66cc91bfce62730481f22d01">
      <documentation>Workflow из ТЗ: от поиска контактов до контроля исполнения.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Формирование отчётов" id="id-ac55827f406f5c5932687fab">
      <documentation>Отчёты за период в XLSX, XLS, PDF и JSON.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Анализ статистики" id="id-2513a860fafbd335fc79d1e9">
      <documentation>Диаграммы и графики, выгрузка PNG и PDF.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Актуализация каталогов" id="id-f6fb2e72c44754c0c5ed6900">
      <documentation>Загрузка XLSX/XLS/CSV по маппингу полей ТЗ.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Управление доступом" id="id-4cd5043dad32edf2ba53a883">
      <documentation>Учётные записи, роли, видимость данных.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Получение данных из LMS и сайта" id="id-aea41f35c4c41f5b4b8d8d21">
      <documentation>JSON по API с добавлением в workflow.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Настройка workflow" id="id-25ab396bbff38da5b5c3913c">
      <documentation>Создание и изменение наборов этапов.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-5875fe3d5ccfd06de5e82dec" type="application">
    <element xsi:type="archimate:ApplicationService" name="Синхронизация данных CRM" id="id-9074cc49b43f469a2a0a1a39">
      <documentation>POST /state/changes, GET /state — изменения без перезагрузки страницы, кэш действий.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Файлы этапов" id="id-f7ec396e7805406c1f39c0dd">
      <documentation>png, jpeg, pdf, zip, gzip, rar, doc(x), xls(x); шифрование при хранении.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Конструктор отчётов" id="id-6deb359b18a9a9bce0c8974a">
      <documentation>Фильтры по периоду, вузам, направлениям, продуктам, ответственным.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Импорт каталогов" id="id-99cb2149f78aaacb9160f4e3">
      <documentation>POST /imports: план, проверка, атомарное применение и откат.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Интеграции LMS / сайт" id="id-fa0f52beceac26eb1aece15e">
      <documentation>POST /integrations/{source}/sync.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Аутентификация и авторизация" id="id-fb5a0a0a2d33a37b52cf4230">
      <documentation>OIDC Authorization Code + PKCE, роли kam / manager_lead / admin.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Уведомления о смене этапа" id="id-e24b104530e848978ca05072">
      <documentation>Telegram, с минимизацией ПДн.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ИИ-помощник" id="id-67fb1f042dee9a32e82e2022">
      <documentation>Локальная модель: ответы по справке и действия с правами пользователя.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Конструктор workflow" id="id-b09f6d189f87a2145ceb11d4">
      <documentation>Этапы, сроки, подсказки, необязательные этапы.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Веб-клиент (React 19 SPA)" id="id-f9dfe6186b087fe2e28250a0">
      <documentation>Интерфейс, фильтры, отчёты XLSX/XLS/PDF/JSON, импорт XLSX/XLS/CSV, офлайн-кэш.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="CRM API (FastAPI)" id="id-f164bd62704aa762c03bf7e1">
      <documentation>REST /api/v1, Swagger UI /docs, проверка прав при каждом сохранении, шифрование ПДн.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Telegram-бот (worker)" id="id-2605351236ed2e31ca25f95d">
      <documentation>Long polling, очередь уведомлений в БД.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Keycloak (realm it-school)" id="id-7ebc49d71dc318747619aae1">
      <documentation>Вход, политика паролей, защита от подбора, журналы событий.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Ollama (локальная LLM)" id="id-74b00c58e133306743650f2c">
      <documentation>Qwen; данные не покидают сервер.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="LMS ИТ Школы" id="id-f602fe0fa8d1fc3efb4528a7">
      <documentation>Внешняя система: JSON по API.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Сайт ИТ Школы (CMS Laravel)" id="id-d5cfd03aa24d89a7e7cd3c45">
      <documentation>Внешняя система: JSON по API.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Telegram Bot API" id="id-def7483e49190a73f3eae3ca">
      <documentation>Внешний сервис за пределами РФ.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Снимок данных CRM" id="id-fc844d87473fc65e01774a28">
      <documentation>state_snapshots: вузы, взаимодействия, события, пользователи. AES-256-GCM.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Вложения" id="id-5ff19431e6f1edbbf267b2c4">
      <documentation>Файлы этапов на диске. AES-256-GCM потоком.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="История импортов" id="id-cd7848eacd6c8e2e66eec50b">
      <documentation>import_jobs: для отката. AES-256-GCM.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Очередь уведомлений" id="id-f02d0ee0cec82dfba253997c">
      <documentation>telegram_deliveries. AES-256-GCM.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-531554e801904c483405f49b" type="technology">
    <element xsi:type="archimate:Node" name="Linux-сервер (Docker Compose)" id="id-d275092342a304e1bfda4517">
      <documentation>Ubuntu; deploy/compose.yml, deploy/deploy.sh.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Caddy (HTTPS, TLS)" id="id-606b06a99c9958e764598007">
      <documentation>Сертификат Let's Encrypt, обратный прокси.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 16" id="id-07cb87899e9937933a0f710b">
      <documentation>Базы CRM и Keycloak.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Том вложений" id="id-ee6ae8170ed9d01529ae2a6c">
      <documentation>Docker volume attachments.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-92ac1ff060a5ae1698676fff" type="motivation">
    <element xsi:type="archimate:Requirement" name="152-ФЗ «О персональных данных»" id="id-a5b6fe690787b8ca976ccaea">
      <documentation>Шифрование ПДн при хранении и передаче, минимизация, политика обработки, согласие на трансграничную передачу.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Приказ ФСТЭК № 117" id="id-b1aef0dcc73c2bb994281cb9">
      <documentation>Идентификация и аутентификация, управление доступом, регистрация событий, защита веб-интерфейса.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Отклик ≤ 1 с, 50 пользователей, 10 отчётов" id="id-7ae5463760d10233726b404b">
      <documentation>Нефункциональные требования ТЗ.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-1a8bf7d2e2ee8b51396df7bd" type="implementation_migration"/>
