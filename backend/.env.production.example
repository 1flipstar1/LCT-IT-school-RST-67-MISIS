# Copy to a file outside version control and replace every CHANGE_ME value.
APP_ENV=production
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=127.0.0.1

POSTGRES_USER=lct
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=lct_db
DATABASE_URL=postgresql+psycopg://lct:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/lct_db

JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_AUTH_ENABLED=false
CORS_ORIGINS=https://crm.example.ru
ALLOWED_HOSTS=crm.example.ru,localhost,127.0.0.1

KEYCLOAK_PUBLIC_URL=https://sso.example.ru
KEYCLOAK_REALM=it-school
KEYCLOAK_ISSUER_URL=https://sso.example.ru/realms/it-school
KEYCLOAK_AUDIENCE=rtk-it-school-api
KEYCLOAK_CLIENT_ID=rtk-it-school-web

INTEGRATION_MOCK_ENABLED=false
INTEGRATION_SCHEDULER_ENABLED=true
LMS_API_URL=https://lms.example.ru/api/v1/metrics
LMS_API_TOKEN=CHANGE_ME_LMS_TOKEN
WEBSITE_API_URL=https://school.example.ru/api/v1/leads
WEBSITE_API_TOKEN=CHANGE_ME_WEBSITE_TOKEN
LMS_SYNC_INTERVAL_SECONDS=14400
WEBSITE_SYNC_INTERVAL_SECONDS=900
INTEGRATION_SYSTEM_USER_ID=usr-8

MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=lct-artifacts
RABBITMQ_DEFAULT_USER=lct
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# Keep infrastructure consoles on loopback unless protected separately.
LOCAL_ADMIN_BIND_ADDRESS=127.0.0.1
