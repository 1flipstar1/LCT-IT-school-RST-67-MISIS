# A domain gives the deployment an automatic, trusted HTTPS certificate.
# Example: school.example.ru. For a temporary IP-only demo, use http://<PUBLIC_IP>.
SITE_ADDRESS=school.example.ru
ACME_EMAIL=admin@example.ru

# This configuration intentionally starts in demo mode. Do not expose real
# personal or contractual data until Keycloak/another real identity provider is configured.
APP_ENV=demo
CORS_ORIGINS=https://school.example.ru

POSTGRES_USER=lct_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password-without-url-special-characters
POSTGRES_DB=lct_db
JWT_SECRET=replace-with-another-long-random-secret-at-least-32-characters

OLLAMA_MODEL=qwen3:8b
