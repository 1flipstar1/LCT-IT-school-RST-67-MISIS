# Local mode works with SQLite and permits anonymous snapshot access.
APP_ENV=development
DATABASE_URL=sqlite:///./lct_state.db
DATABASE_ECHO=false

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated HTTP Host values. Use the public hostname in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Replace in every non-local environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=rtk-it-school-api
JWT_AUDIENCE=rtk-it-school-web
JWT_EXPIRES_SECONDS=28800
# Defaults to true outside production and false in production.
# DEMO_AUTH_ENABLED=true

# Production example:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lct_db
# KEYCLOAK_ISSUER_URL=https://sso.example.ru/realms/it-school
# KEYCLOAK_AUDIENCE=rtk-it-school-api
# KEYCLOAK_CLIENT_ID=rtk-it-school-web
# KEYCLOAK_JWKS_URL=https://sso.example.ru/realms/it-school/protocol/openid-connect/certs

# Optional overrides.
# SEED_STATE_PATH=/app/app/seed_state.json
# FRONTEND_DIST_PATH=/frontend/dist
# MAX_STATE_BYTES=20971520
# ATTACHMENT_STORAGE_PATH=/app/data/attachments
# MAX_ATTACHMENT_BYTES=26214400

# Pull integrations. The public task explicitly leaves the final contracts to
# the customer; both endpoints accept a JSON array or {items|records|data: []}.
# LMS_API_URL=https://lms.example.ru/api/v1/metrics
# LMS_API_TOKEN=replace-me
# WEBSITE_API_URL=https://school.example.ru/api/v1/leads
# WEBSITE_API_TOKEN=replace-me
# INTEGRATION_TIMEOUT_SECONDS=20
# With no external URL, non-production modes use deterministic LMS/site data.
# Production always disables mocks even if this is set to true.
# INTEGRATION_MOCK_ENABLED=true
# INTEGRATION_SCHEDULER_ENABLED=false
# LMS_SYNC_INTERVAL_SECONDS=14400
# WEBSITE_SYNC_INTERVAL_SECONDS=900
# INTEGRATION_SYSTEM_USER_ID=usr-8

# Frontend build variables for Authorization Code + PKCE:
# KEYCLOAK_PUBLIC_URL=https://sso.example.ru
# KEYCLOAK_REALM=it-school

# Background imports/reports. Defaults need no external services.
JOB_STORAGE_BACKEND=local
JOB_QUEUE_BACKEND=inline
LOCAL_STORAGE_PATH=./.data/objects
MAX_UPLOAD_BYTES=26214400
MAX_IMPORT_ROWS=20000
MAX_IMPORT_COLUMNS=200

# S3-compatible storage (MinIO in docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lct-artifacts
S3_REGION=us-east-1
S3_SECURE=false

# RabbitMQ.
RABBITMQ_URL=amqp://lct:lct@localhost:5672/%2F
RABBITMQ_IMPORT_QUEUE=lct.imports
RABBITMQ_REPORT_QUEUE=lct.reports
# Optional comma-separated subset for a dedicated worker process.
# WORKER_QUEUES=lct.imports
